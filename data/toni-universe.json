  "nodes": [
    {
      "id": "fde",
      "layer": "core",
      "status": "live",
      "title": "Enterprise FDE",
      "english": "Forward Deployed Engineering",
      "summary": "面向生产结果的驻场工程交付，从关键业务问题负责到系统稳定运行。",
      "detail": "FDE 团队进入客户一线，与业务负责人共同诊断关键流程，完成系统设计、开发、部署和运营验证，并对采用、稳定性与业务结果持续负责。它不同于只提供建议的咨询，也不同于按需求清单交付的软件外包。",
      "color": "#b08a52",
      "weight": 5,
      "position": [0, 0, 0],
      "href": "/aila#cooperation",
      "tags": ["核心业务", "客户现场", "生产交付"]
    },
    {
      "id": "discover",
      "layer": "delivery",
      "status": "live",
      "title": "进入现场",
      "english": "DISCOVER",
      "summary": "确认影响业务结果的真实阻塞、决策链和数据证据。",
      "detail": "访谈一线角色、观察实际操作、核对数据来源与责任边界，输出问题定义、现状流程、关键约束和可验证的成功指标。",
      "color": "#a77a52",
      "weight": 3.4,
      "position": [-6.2, 2.2, 1.2],
      "href": "/tools/research",
      "tags": ["调研", "问题定义", "流程观察"]
    },
